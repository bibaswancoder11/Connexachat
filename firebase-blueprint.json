{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User profile with display information, handle, and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User unique ID" },
        "displayName": { "type": "string", "description": "Display name of the user" },
        "username": { "type": "string", "description": "Unique handle/username (lowercased)" },
        "userTag": { "type": "string", "description": "Unique numeric tag like #1042" },
        "email": { "type": "string", "description": "Email address" },
        "photoURL": { "type": "string", "description": "Profile picture URL or Base64 data" },
        "bio": { "type": "string", "description": "User bio or tagline" },
        "status": { "type": "string", "description": "Online status: online, offline, away" },
        "lastSeen": { "type": "string", "description": "Last activity timestamp" },
        "createdAt": { "type": "string", "description": "Account creation time" },
        "pushTokens": { "type": "object", "description": "Map of FCM Android device push tokens" },
        "pushSubscriptions": { "type": "object", "description": "Map of Web Push browser subscriptions" }
      },
      "required": ["uid", "username"]
    },
    "usernames": {
      "title": "Username Reservation",
      "description": "Mapping from reserved username to user UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "UID associated with reserved username" }
      },
      "required": ["uid"]
    },
    "friendRequests": {
      "title": "Friend Request",
      "description": "Friend request between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "fromUid_toUid request ID" },
        "fromUid": { "type": "string", "description": "Sender User ID" },
        "fromUsername": { "type": "string", "description": "Sender username" },
        "fromDisplayName": { "type": "string", "description": "Sender display name" },
        "fromPhotoURL": { "type": "string", "description": "Sender avatar photo URL" },
        "toUid": { "type": "string", "description": "Recipient User ID" },
        "toUsername": { "type": "string", "description": "Recipient username" },
        "status": { "type": "string", "description": "Request status: pending, accepted, rejected" },
        "createdAt": { "type": "string", "description": "Request creation timestamp" }
      },
      "required": ["fromUid", "toUid", "status"]
    },
    "friends": {
      "title": "Friendship",
      "description": "Friend relationship between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Sorted pair ID uidA_uidB" },
        "users": { "type": "array", "description": "Array of 2 user IDs" },
        "createdAt": { "type": "string", "description": "Friendship establishment timestamp" }
      },
      "required": ["users"]
    },
    "chats": {
      "title": "Chat Room",
      "description": "Direct or group chat conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Chat room ID" },
        "participants": { "type": "array", "description": "Array of participant user IDs" },
        "isGroup": { "type": "boolean", "description": "Whether this is a group chat" },
        "groupName": { "type": "string", "description": "Name of the group chat" },
        "groupAvatar": { "type": "string", "description": "Avatar/icon URL for group chat" },
        "adminUids": { "type": "array", "description": "Array of admin user UIDs" },
        "createdBy": { "type": "string", "description": "UID of group creator" },
        "lastMessage": { "type": "string", "description": "Preview snippet of last message" },
        "lastMessageSenderId": { "type": "string", "description": "User ID of last sender" },
        "lastMessageTime": { "type": "string", "description": "Timestamp of last message" },
        "updatedAt": { "type": "string", "description": "Chat update timestamp" },
        "unreadCounts": { "type": "object", "description": "Map of unread message counts per user UID" },
        "typing": { "type": "object", "description": "Map of typing indicators per user UID" }
      },
      "required": ["participants"]
    },
    "messages": {
      "title": "Chat Message",
      "description": "Individual message in a chat conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique message ID" },
        "chatId": { "type": "string", "description": "Parent chat ID" },
        "senderId": { "type": "string", "description": "Sender user ID" },
        "senderName": { "type": "string", "description": "Sender display name" },
        "senderPhoto": { "type": "string", "description": "Sender profile picture URL" },
        "text": { "type": "string", "description": "Text message content" },
        "mediaUrl": { "type": "string", "description": "Media data URL or connexa-media:// chunked asset reference" },
        "mediaThumbnail": { "type": "string", "description": "Poster thumbnail image URL for video attachments" },
        "mediaDuration": { "type": "number", "description": "Duration in seconds for video/audio attachments" },
        "mediaSize": { "type": "number", "description": "Byte size of attached media up to 55MB" },
        "filename": { "type": "string", "description": "Original attachment filename" },
        "fileSize": { "type": "number", "description": "Attachment size in bytes" },
        "fileType": { "type": "string", "description": "Attachment MIME type" },
        "type": { "type": "string", "description": "Message type: text, image, video, audio, file, system" },
        "reactions": { "type": "object", "description": "Reactions map { [uid]: emoji }" },
        "timestamp": { "type": "string", "description": "Message sent timestamp" },
        "readBy": { "type": "array", "description": "Array of user IDs who read the message" }
      },
      "required": ["chatId", "senderId"]
    },
    "mediaAssets": {
      "title": "Chunked Media Asset",
      "description": "Metadata manifest for chunked videos and files up to 55MB",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Unique media asset ID" },
        "uploaderId": { "type": "string", "maxLength": 128, "description": "Uploader user UID" },
        "mimeType": { "type": "string", "maxLength": 120, "description": "Media MIME type (e.g. video/mp4)" },
        "filename": { "type": "string", "maxLength": 240, "description": "Original file name" },
        "size": { "type": "number", "description": "Total file size in bytes (max 57671680 for 55MB)" },
        "chunkSize": { "type": "number", "description": "Raw binary chunk size in bytes (540672)" },
        "totalChunks": { "type": "number", "description": "Total number of chunk documents (1 to 112)" },
        "status": { "type": "string", "enum": ["uploading", "ready"], "description": "Upload completion status" },
        "createdAt": { "type": "string", "description": "Creation server timestamp" }
      },
      "required": ["id", "uploaderId", "mimeType", "filename", "size", "chunkSize", "totalChunks", "status"]
    },
    "mediaChunks": {
      "title": "Media Binary Chunk",
      "description": "Individual Base64-encoded binary slice (<= 720,896 chars) of a 55MB media asset",
      "type": "object",
      "properties": {
        "index": { "type": "number", "description": "Zero-based chunk index" },
        "data": { "type": "string", "maxLength": 760000, "description": "Base64-encoded binary slice" }
      },
      "required": ["index", "data"]
    },
    "calls": {
      "title": "Call Session",
      "description": "WebRTC audio or video call session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique call session ID" },
        "chatId": { "type": "string", "description": "Associated chat ID" },
        "type": { "type": "string", "description": "Call type: audio or video" },
        "callerUid": { "type": "string", "description": "UID of the caller" },
        "callerName": { "type": "string", "description": "Display name of the caller" },
        "callerAvatar": { "type": "string", "description": "Avatar photo URL of caller" },
        "recipientUid": { "type": "string", "description": "UID of the recipient" },
        "recipientName": { "type": "string", "description": "Display name of the recipient" },
        "recipientAvatar": { "type": "string", "description": "Avatar photo URL of recipient" },
        "status": { "type": "string", "description": "Call status: ringing, connected, rejected, ended, missed" },
        "offer": { "type": "object", "description": "WebRTC offer SDP description" },
        "answer": { "type": "object", "description": "WebRTC answer SDP description" },
        "createdAt": { "type": "string", "description": "Call initiation timestamp" },
        "connectedAt": { "type": "string", "description": "Call answer/connection timestamp" },
        "endedAt": { "type": "string", "description": "Call completion timestamp" },
        "durationSeconds": { "type": "number", "description": "Total call duration in seconds" }
      },
      "required": ["callerUid", "recipientUid", "status"]
    },
    "iceCandidate": {
      "title": "WebRTC ICE Candidate",
      "description": "Signaling ICE candidate document",
      "type": "object",
      "properties": {
        "candidate": { "type": "string", "description": "SDP candidate string" },
        "sdpMid": { "type": "string", "description": "SDP media stream identification" },
        "sdpMLineIndex": { "type": "number", "description": "SDP m-line index" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "User profiles collection"
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/usernames" },
      "description": "Reserved usernames mapping"
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/friendRequests" },
      "description": "Pending and past friend requests"
    },
    "/friends/{friendshipId}": {
      "schema": { "$ref": "#/entities/friends" },
      "description": "Confirmed friendships collection"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/chats" },
      "description": "Direct and group chat rooms"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/messages" },
      "description": "Messages subcollection within a chat"
    },
    "/mediaAssets/{mediaId}": {
      "schema": { "$ref": "#/entities/mediaAssets" },
      "description": "Chunked media manifests for videos and files up to 55MB"
    },
    "/mediaAssets/{mediaId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/mediaChunks" },
      "description": "Ordered Base64 chunks for 55MB media assets"
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/calls" },
      "description": "WebRTC calls and signaling"
    },
    "/calls/{callId}/callerCandidates/{candidateId}": {
      "schema": { "$ref": "#/entities/iceCandidate" },
      "description": "WebRTC ICE candidates from caller"
    },
    "/calls/{callId}/recipientCandidates/{candidateId}": {
      "schema": { "$ref": "#/entities/iceCandidate" },
      "description": "WebRTC ICE candidates from recipient"
    }
  }
}
